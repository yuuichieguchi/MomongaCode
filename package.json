{
  "name": "momonga-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "vitest run --project unit",
    "test:reuse": "MOMONGA_TLC_REUSE=1 vitest run --project unit",
    "test:tlc-deep": "MOMONGA_TLC_TIER=deep vitest run --project unit test/formal",
    "test:e2e": "vitest run --project e2e",
    "test:packaging": "vitest run --project packaging",
    "typecheck": "node scripts/bundle.ts --journal-thread && tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.ts",
    "sea": "node scripts/sea.ts",
    "test:sea": "vitest run --project packaging scripts/sea.test.ts",
    "test:install": "vitest run --project packaging scripts/install.test.ts",
    "test:release": "vitest run --project packaging scripts/release.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/picomatch": "4.0.3",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "rolldown": "1.2.15",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "@momonga/testkit": "*"
  }
}
