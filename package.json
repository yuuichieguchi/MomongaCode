{
  "name": "momonga-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/picomatch": "4.0.3",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "@momonga/testkit": "*"
  }
}
