{
  "format": "momonga-inject/1",
  "name": "momonga-inject",
  "scenarios": [
    {
      "id": "kill-at-step",
      "fault": "kill_at_step",
      "requires": "any",
      "trials": 3,
      "task": {
        "prompt": "Run the six steps in order.",
        "steps": [
          {
            "call": {
              "name": "Bash",
              "input": {
                "command": "echo step-1 >> {ledger}"
              }
            }
          },
          {
            "call": {
              "name": "Bash",
              "input": {
                "command": "echo step-2 >> {ledger}"
              }
            }
          },
          {
            "call": {
              "name": "Bash",
              "input": {
                "command": "echo step-3 >> {ledger}"
              }
            }
          },
          {
            "call": {
              "name": "Bash",
              "input": {
                "command": "echo step-4 >> {ledger}"
              }
            }
          },
          {
            "call": {
              "name": "Bash",
              "input": {
                "command": "echo step-5 >> {ledger}"
              }
            }
          },
          {
            "call": {
              "name": "Bash",
              "input": {
                "command": "echo step-6 >> {ledger}"
              }
            }
          },
          {
            "text": "done"
          }
        ]
      },
      "effect": "step",
      "params": {
        "points": [
          "model.requested",
          "tool.started"
        ]
      },
      "expect": {
        "status": "COMPLETED",
        "episodeOutcomes": [
          "recovered"
        ],
        "minEpisodes": 1
      }
    },
