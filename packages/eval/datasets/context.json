{
  "format": "momonga-eval-context/1",
  "name": "context-starter",
  "cases": [
    {
      "id": "rename-module-on",
      "description": "Measures whether a long task still finishes after twelve noise turns when automatic compaction is on: the rule 'use ES modules only' must be loaded, and the rename must happen.",
      "scenario": "rename-module",
      "compaction": "on",
      "input": "Rename src/parse.ts to src/parser.ts and update every import.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/parse.ts": "export const parse = (text) => text.trim();\n", "src/main.ts": "import { parse } from './parse.ts';\n" },
      "rules": [{ "id": "use-esm", "kind": "constraint", "target": "module-format", "text": "Use ES modules only.", "inScope": true, "live": true, "supersedes": [] }],
      "revisionDepth": 0,
      "noise": { "level": 12, "topics": ["bundling", "imports"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "src/parser\\.ts" }]
    },
    {
      "id": "rename-module-off",
      "description": "The same task and the same twelve noise turns with context.autoCompact false: the run keeps the full history, or stops with a budget notice when it does not fit. It is the contrast for rename-module-on.",
      "scenario": "rename-module",
      "compaction": "off",
      "input": "Rename src/parse.ts to src/parser.ts and update every import.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/parse.ts": "export const parse = (text) => text.trim();\n", "src/main.ts": "import { parse } from './parse.ts';\n" },
      "rules": [{ "id": "use-esm", "kind": "constraint", "target": "module-format", "text": "Use ES modules only.", "inScope": true, "live": true, "supersedes": [] }],
      "revisionDepth": 0,
      "noise": { "level": 12, "topics": ["bundling", "imports"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "src/parser\\.ts" }]
    },
    {
      "id": "revised-test-runner-on",
      "description": "Measures governance under a revision chain of depth 2 (jest, then mocha, then vitest) with a rule that is out of scope, after 25 noise turns about testing: only the last runner may govern, and the answer must name vitest and neither jest nor mocha.",
      "scenario": "revised-test-runner",
      "compaction": "on",
      "input": "Add a test for the date helper and run it with the project's test runner.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/date.ts": "export const year = (at) => new Date(at).getUTCFullYear();\n" },
      "rules": [
        { "id": "runner-1", "kind": "constraint", "target": "test-runner", "text": "Run tests with jest.", "inScope": true, "live": true, "supersedes": [] },
        { "id": "runner-2", "kind": "constraint", "target": "test-runner", "text": "Run tests with mocha.", "inScope": true, "live": true, "supersedes": ["runner-1"] },
        { "id": "runner-3", "kind": "constraint", "target": "test-runner", "text": "Run tests with vitest.", "inScope": true, "live": true, "supersedes": ["runner-2"] },
        { "id": "legacy-style", "kind": "preference", "target": "legacy-style", "text": "Keep tabs in legacy files.", "inScope": false, "live": true, "supersedes": [] }
      ],
      "revisionDepth": 2,
      "noise": { "level": 25, "topics": ["testing", "assertions"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "^(?![\\s\\S]*\\b(jest|mocha)\\b)[\\s\\S]*\\bvitest\\b" }]
    },
    {
      "id": "revised-test-runner-off",
      "description": "The same revision chain and noise with context.autoCompact false; the contrast for revised-test-runner-on.",
      "scenario": "revised-test-runner",
      "compaction": "off",
      "input": "Add a test for the date helper and run it with the project's test runner.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/date.ts": "export const year = (at) => new Date(at).getUTCFullYear();\n" },
      "rules": [
        { "id": "runner-1", "kind": "constraint", "target": "test-runner", "text": "Run tests with jest.", "inScope": true, "live": true, "supersedes": [] },
        { "id": "runner-2", "kind": "constraint", "target": "test-runner", "text": "Run tests with mocha.", "inScope": true, "live": true, "supersedes": ["runner-1"] },
        { "id": "runner-3", "kind": "constraint", "target": "test-runner", "text": "Run tests with vitest.", "inScope": true, "live": true, "supersedes": ["runner-2"] },
        { "id": "legacy-style", "kind": "preference", "target": "legacy-style", "text": "Keep tabs in legacy files.", "inScope": false, "live": true, "supersedes": [] }
      ],
      "revisionDepth": 2,
      "noise": { "level": 25, "topics": ["testing", "assertions"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "^(?![\\s\\S]*\\b(jest|mocha)\\b)[\\s\\S]*\\bvitest\\b" }]
    },
    {
      "id": "file-changed-between-runs-on",
      "description": "Measures stale memory: a person adds the memory 'LIMIT in config.ts is 10.' bound to config.ts, and config.ts changes to 20 before the second run, so the memory shows as stale in that run. The second run must read the file and not repeat the old value on the memory's word.",
      "scenario": "file-changed-between-runs",
      "compaction": "on",
      "input": "Report the value of LIMIT in config.ts.",
      "permissionMode": "default",
      "onAsk": "reject_once",
      "runs": 2,
      "minPassRate": 1,
      "files": { "config.ts": "export const LIMIT = 10;\n" },
      "workspace": [{ "beforeRun": 1, "write": { "config.ts": "export const LIMIT = 20;\n" } }],
      "memories": [{ "text": "LIMIT in config.ts is 10.", "paths": ["config.ts"] }],
      "rules": [],
      "revisionDepth": 0,
      "noise": { "level": 0, "topics": ["configuration"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "toolCalled", "name": "Read" }, { "kind": "finalTextMatches", "pattern": "\\b(10|20)\\b" }]
    },
    {
      "id": "file-changed-between-runs-off",
      "description": "The same stale memory and file change with context.autoCompact false; the contrast for file-changed-between-runs-on.",
      "scenario": "file-changed-between-runs",
      "compaction": "off",
      "input": "Report the value of LIMIT in config.ts.",
      "permissionMode": "default",
      "onAsk": "reject_once",
      "runs": 2,
      "minPassRate": 1,
      "files": { "config.ts": "export const LIMIT = 10;\n" },
      "workspace": [{ "beforeRun": 1, "write": { "config.ts": "export const LIMIT = 20;\n" } }],
      "memories": [{ "text": "LIMIT in config.ts is 10.", "paths": ["config.ts"] }],
      "rules": [],
      "revisionDepth": 0,
      "noise": { "level": 0, "topics": ["configuration"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "toolCalled", "name": "Read" }, { "kind": "finalTextMatches", "pattern": "\\b(10|20)\\b" }]
    },
    {
      "id": "lint-chain-on",
      "description": "Measures a revision chain of depth 1 generated from revisionChain (lint-0, then lint-1) behind eight noise turns: only the last revision may govern, so the answer must name lint-1 and not lint-0.",
      "scenario": "lint-chain",
      "compaction": "on",
      "input": "Check src/util.ts with the project's linter and say which linter you used.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/util.ts": "export const id = (value) => value;\n" },
      "rules": [],
      "revisionDepth": 1,
      "revisionChain": { "id": "lint", "kind": "constraint", "target": "lint-tool", "text": "Use the linter named lint-{revision}." },
      "noise": { "level": 8, "topics": ["logging", "formatting"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "^(?![\\s\\S]*\\blint-0\\b)[\\s\\S]*\\blint-1\\b" }]
    },
    {
      "id": "lint-chain-off",
      "description": "The same depth 1 chain and noise with context.autoCompact false; the contrast for lint-chain-on.",
      "scenario": "lint-chain",
      "compaction": "off",
      "input": "Check src/util.ts with the project's linter and say which linter you used.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/util.ts": "export const id = (value) => value;\n" },
      "rules": [],
      "revisionDepth": 1,
      "revisionChain": { "id": "lint", "kind": "constraint", "target": "lint-tool", "text": "Use the linter named lint-{revision}." },
      "noise": { "level": 8, "topics": ["logging", "formatting"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "^(?![\\s\\S]*\\blint-0\\b)[\\s\\S]*\\blint-1\\b" }]
    },
    {
      "id": "report-chain-on",
      "description": "Measures a revision chain of depth 3 generated from revisionChain (format-0 to format-3) behind sixteen noise turns: three superseded rules must stay out, so the answer must name format-3 and none of the older formats.",
      "scenario": "report-chain",
      "compaction": "on",
      "input": "Write a one-line summary of src/util.ts and say which report format you used.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/util.ts": "export const id = (value) => value;\n" },
      "rules": [],
      "revisionDepth": 3,
      "revisionChain": { "id": "format", "kind": "preference", "target": "report-style", "text": "Write every report as format-{revision}." },
      "noise": { "level": 16, "topics": ["documentation", "metrics"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "^(?![\\s\\S]*\\bformat-[0-2]\\b)[\\s\\S]*\\bformat-3\\b" }]
    },
    {
      "id": "report-chain-off",
      "description": "The same depth 3 chain and noise with context.autoCompact false; the contrast for report-chain-on.",
      "scenario": "report-chain",
      "compaction": "off",
      "input": "Write a one-line summary of src/util.ts and say which report format you used.",
      "permissionMode": "acceptEdits",
      "onAsk": "reject_once",
      "runs": 1,
      "minPassRate": 1,
      "files": { "src/util.ts": "export const id = (value) => value;\n" },
      "rules": [],
      "revisionDepth": 3,
      "revisionChain": { "id": "format", "kind": "preference", "target": "report-style", "text": "Write every report as format-{revision}." },
      "noise": { "level": 16, "topics": ["documentation", "metrics"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "finalTextMatches", "pattern": "^(?![\\s\\S]*\\bformat-[0-2]\\b)[\\s\\S]*\\bformat-3\\b" }]
    },
    {
      "id": "stale-retries-on",
      "description": "Measures a second stale memory under four noise turns: a person adds 'RETRIES in flags.ts is 3.' bound to flags.ts, flags.ts changes to 5 before the second run, and that run must read the file and report the value it holds.",
      "scenario": "stale-retries",
      "compaction": "on",
      "input": "Report the value of RETRIES in flags.ts.",
      "permissionMode": "default",
      "onAsk": "reject_once",
      "runs": 2,
      "minPassRate": 1,
      "files": { "flags.ts": "export const RETRIES = 3;\n" },
      "workspace": [{ "beforeRun": 1, "write": { "flags.ts": "export const RETRIES = 5;\n" } }],
      "memories": [{ "text": "RETRIES in flags.ts is 3.", "paths": ["flags.ts"] }],
      "rules": [],
      "revisionDepth": 0,
      "noise": { "level": 4, "topics": ["configuration", "networking"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "toolCalled", "name": "Read" }, { "kind": "finalTextMatches", "pattern": "\\b(3|5)\\b" }]
    },
    {
      "id": "stale-retries-off",
      "description": "The same stale memory, file change and noise with context.autoCompact false; the contrast for stale-retries-on.",
      "scenario": "stale-retries",
      "compaction": "off",
      "input": "Report the value of RETRIES in flags.ts.",
      "permissionMode": "default",
      "onAsk": "reject_once",
      "runs": 2,
      "minPassRate": 1,
      "files": { "flags.ts": "export const RETRIES = 3;\n" },
      "workspace": [{ "beforeRun": 1, "write": { "flags.ts": "export const RETRIES = 5;\n" } }],
      "memories": [{ "text": "RETRIES in flags.ts is 3.", "paths": ["flags.ts"] }],
      "rules": [],
      "revisionDepth": 0,
      "noise": { "level": 4, "topics": ["configuration", "networking"] },
      "graders": [{ "kind": "status", "equals": "COMPLETED" }, { "kind": "toolCalled", "name": "Read" }, { "kind": "finalTextMatches", "pattern": "\\b(3|5)\\b" }]
    }
  ]
}
