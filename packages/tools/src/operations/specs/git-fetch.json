{
  "name": "GitFetch",
  "description": "Fetches one branch from a remote into its remote-tracking branch. The checked-out branch and the working tree do not change; use GitUpdate to bring the checked-out branch up to the fetched commits. The result is checked against the remote: the remote-tracking branch must be at the commit the remote has.",
  "kind": "execute",
  "sideEffect": "exec",
  "title": "Fetch {input.branch} from {input.remote}",
  "subject": { "kind": "repo", "remote": "{input.remote}", "refs": ["{input.branch}"], "direction": "fetch" },
  "approval": "rule",
  "input": {
    "type": "object",
    "properties": {
      "remote": { "type": "string", "pattern": "^[^-\\s][^\\s]*$", "description": "The remote name" },
      "branch": { "type": "string", "refName": true, "description": "The branch name on the remote" }
    },
    "required": ["remote", "branch"],
    "additionalProperties": false
  },
  "timeoutMs": 120000,
  "observe": [
    { "id": "remoteRef", "via": { "argv": ["git", "ls-remote", "--exit-code", "{call.destination}", "refs/heads/{input.branch}"], "network": "destination", "extract": "firstField", "each": "destinations" } },
    { "id": "trackingRef", "via": { "argv": ["git", "rev-parse", "--verify", "-q", "refs/remotes/{input.remote}/{input.branch}"], "extract": "trim", "emptyOnFailure": true } }
  ],
  "effect": { "network": "destinations", "argv": ["git", "fetch", "-q", "--no-tags", "{input.remote}", "+refs/heads/{input.branch}:refs/remotes/{input.remote}/{input.branch}"] },
  "applied": [["after.trackingRef", "after.remoteRef"]],
  "unchanged": [{ "ifObserved": "before.trackingRef", "then": [["after.trackingRef", "before.trackingRef"]], "else": [["after.trackingRef", { "literal": "" }]] }],
  "guard": "compare_and_set",
  "supersedes": [["git", "fetch"]],
  "report": "The remote-tracking branch {input.remote}/{input.branch} is at {after.trackingRef}, the commit the remote has."
}
