{
  "id": "github",
  "auth": { "header": "Authorization", "prefix": "Bearer ", "gitUsername": "x-access-token" },
  "errorText": { "message": "message", "details": "errors", "detail": "message" },
  "operations": {
    "listPullRequests": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/pulls",
      "query": { "head": "{owner}:{head}", "base": "{base}", "state": "open", "per_page": "100" },
      "success": [200],
      "items": "",
      "paging": "link",
      "result": { "number": "number", "url": "html_url", "headSha": "head.sha", "state": "state", "merged": "merged" }
    },
    "getPullRequest": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/pulls/{number}",
      "success": [200],
      "result": { "number": "number", "url": "html_url", "headSha": "head.sha", "state": "state", "merged": "merged" }
    },
    "createPullRequest": {
      "method": "POST",
      "path": "/repos/{owner}/{name}/pulls",
      "body": { "head": "{head}", "base": "{base}", "title": "{title}", "body": "{body}" },
      "success": [201],
      "answers": [{ "status": 422, "messageIncludes": "A pull request already exists", "outcome": "already_exists" }, { "status": 422, "outcome": "failed" }],
      "result": { "number": "number", "url": "html_url", "headSha": "head.sha" }
    },
    "mergePullRequest": {
      "method": "PUT",
      "path": "/repos/{owner}/{name}/pulls/{number}/merge",
      "body": { "sha": "{headSha}" },
      "success": [200],
      "answers": [{ "status": 409, "outcome": "conflict" }, { "status": 405, "outcome": "failed" }, { "status": 422, "outcome": "failed" }],
      "result": { "sha": "sha" }
    },
    "getBranch": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/branches/{branch}",
      "success": [200],
      "result": { "sha": "commit.sha" }
    },
    "listChecks": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/commits/{headSha}/check-runs",
      "query": { "per_page": "100" },
      "success": [200],
      "items": "check_runs",
      "paging": "link",
      "result": { "name": "name", "status": "status", "conclusion": "conclusion" }
    },
    "listComments": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/issues/{number}/comments",
      "query": { "per_page": "100" },
      "success": [200],
      "items": "",
      "paging": "link",
      "result": { "id": "id", "body": "body" }
    },
    "listReviewComments": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/pulls/{number}/comments",
      "query": { "per_page": "100" },
      "success": [200],
      "items": "",
      "paging": "link",
      "result": { "id": "id", "path": "path", "line": "line", "body": "body" }
    },
    "getIssue": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/issues/{number}",
      "success": [200],
      "result": { "number": "number", "url": "html_url", "title": "title", "body": "body", "state": "state", "author": "user.login", "authorAssociation": "author_association", "pullRequest": "pull_request.url" }
    },
    "listIssues": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/issues",
      "query": { "state": "open", "labels": "{labels}", "per_page": "100" },
      "success": [200],
      "items": "",
      "paging": "link",
      "result": { "number": "number", "url": "html_url", "title": "title", "author": "user.login", "authorAssociation": "author_association", "pullRequest": "pull_request.url" }
    },
    "listIssueComments": {
      "method": "GET",
      "path": "/repos/{owner}/{name}/issues/{number}/comments",
      "query": { "per_page": "100" },
      "success": [200],
      "items": "",
      "paging": "link",
      "result": { "id": "id", "body": "body", "author": "user.login" }
    },
    "createIssueComment": {
      "method": "POST",
      "path": "/repos/{owner}/{name}/issues/{number}/comments",
      "body": { "body": "{body}" },
      "success": [201],
      "result": { "id": "id" }
    },
    "createComment": {
      "method": "POST",
      "path": "/repos/{owner}/{name}/issues/{number}/comments",
      "body": { "body": "{body}" },
      "success": [201],
      "result": { "id": "id" }
    }
  }
}
