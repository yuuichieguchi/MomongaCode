{
  "kinds": {
    "O": "owned by the caller: the operation takes the signal of its asker and holds no number",
    "P": "a promise stated to the person: a setting or a value derived from one, whose expiry loses no work and gives no wrong verdict",
    "C": "a cadence or a retention: how often a waiter asks again, or how long a record is kept",
    "stated": "a product choice that guards no host operation: a size or a count with its reason in the constants document"
  },
  "fields": {
    "owner": "the package whose plan rules the entry",
    "row": "the file of the constants document that holds the row of the name",
    "lacks": "what the entry still needs before it leaves the burn-down list",
    "signalTimeouts": "per file, the bound each AbortSignal.timeout is built from",
    "literalBounds": "per file, the count of number literals that reach a timer, a signal or a timeout property",
    "clientsWithoutEveryBound": "per file, the count of HTTP client constructions that leave a header, body or connect bound to a default",
    "synchronousChildWaits": "per file, the count of spawnSync, execFileSync and execSync calls that set no timeout, with the item that fixes them"
  },
